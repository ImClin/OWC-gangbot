# Afhankelijkheden (opnieuw op te halen met npm install)
node_modules/

# Geheimen: bot-token en ID's. Deel dit bestand nooit.
.env

# Opslag van de bot: data/owc.json, de dagelijkse back-ups (owc.json.backup-<datum>)
# en de kopie die van een corrupt bestand gemaakt wordt.
data/
*.backup-*
*.corrupt-*

# Logbestanden
*.log
